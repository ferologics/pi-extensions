{
    "name": "@ferologics/pi-extensions",
    "version": "0.9.0",
    "description": "Custom Pi extensions bundle (deep-review, pi-ghostty-hunk, pi-ghostty-lazygit, pi-jobs, pi-notify, pi-quote-copy, pi-slack-user, pi-system-theme, pi-web, plan-mode, pi-verbosity-control)",
    "type": "module",
    "keywords": [
        "pi-package",
        "pi-extension"
    ],
    "author": "ferologics",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ferologics/pi-extensions.git"
    },
    "homepage": "https://github.com/ferologics/pi-extensions#readme",
    "bugs": {
        "url": "https://github.com/ferologics/pi-extensions/issues"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@earendil-works/pi-durable": "1.4.0",
        "@types/jsdom": "^30.0.0",
        "@types/turndown": "^5.0.6",
        "vitest": "^4.1.9"
    },
    "pi": {
        "extensions": [
            "deep-review/index.ts",
            "pi-ghostty-hunk/index.ts",
            "pi-ghostty-lazygit/index.ts",
            "pi-jobs/index.ts",
            "pi-notify/index.ts",
            "pi-quote-copy/index.ts",
            "pi-slack-user/index.ts",
            "pi-system-theme/index.ts",
            "pi-verbosity-control/index.ts",
            "pi-web/index.ts",
            "plan-mode/index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "publishConfig": {
        "access": "public"
    },
    "piRelease": {
        "repo": "ferologics/pi-extensions",
        "branch": "main",
        "subtreePublishRecipe": "publish-extensions"
    },
    "dependencies": {
        "@mozilla/readability": "^0.6.0",
        "jsdom": "^29.1.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2"
    }
}
